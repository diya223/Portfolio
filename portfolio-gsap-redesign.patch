diff --git a/src/app/globals.css b/src/app/globals.css
index 0abff44..e44ef8f 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -1,8 +1,16 @@
 @import "tailwindcss";
 
+/*
+  "Deploy Log" identity
+  ink       – near-black blueprint base
+  blueprint – navy used for panels
+  paper     – warm off-white text
+  signal    – bounding-box orange (primary accent)
+  verified  – teal for "shipped / ok" status
+*/
 :root {
-  --background: #0a0a0f;
-  --foreground: #ededed;
+  --background: #0b0f14;
+  --foreground: #edefec;
 }
 
 @theme inline {
@@ -10,10 +18,17 @@
   --color-foreground: var(--foreground);
   --font-sans: var(--font-geist-sans);
   --font-mono: var(--font-geist-mono);
+
+  --color-ink: #0b0f14;
+  --color-paper: #edefec;
+  --color-blueprint: #16283d;
+  --color-signal: #ff7a3d;
+  --color-verified: #7dd4c0;
 }
 
 html {
-  scroll-behavior: smooth;
+  /* ScrollTrigger pins fight native smooth-scroll; GSAP handles anchor jumps instead. */
+  scroll-behavior: auto;
 }
 
 body {
@@ -23,6 +38,43 @@ body {
 }
 
 ::selection {
-  background: rgb(139 92 246 / 0.4);
-  color: white;
+  background: rgb(255 122 61 / 0.45);
+  color: #fff;
+}
+
+/* Blueprint grid texture */
+.blueprint-grid {
+  background-image:
+    linear-gradient(to right, color-mix(in srgb, var(--color-paper) 6%, transparent) 1px, transparent 1px),
+    linear-gradient(to bottom, color-mix(in srgb, var(--color-paper) 6%, transparent) 1px, transparent 1px);
+  background-size: 44px 44px;
+}
+
+/* Fine film grain so flat colour areas don't read as "default dark mode" */
+.grain::after {
+  content: "";
+  pointer-events: none;
+  position: absolute;
+  inset: 0;
+  opacity: 0.07;
+  mix-blend-mode: overlay;
+  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
+}
+
+/* Outlined display text (footer + marquee) */
+.text-outline {
+  color: transparent;
+  -webkit-text-stroke: 1px color-mix(in srgb, var(--color-paper) 35%, transparent);
+}
+
+/* Split-text lines need room for descenders when masked */
+.split-line {
+  overflow: hidden;
+  padding-bottom: 0.08em;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
 }
